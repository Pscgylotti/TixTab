{
  "name": "tixtab",
  "version": "0.2.37",
  "private": true,
  "description": "Surface-first PDF ink workspace",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "model:texo": "node scripts/download-texo.mjs",
    "desktop": "electron .",
    "start": "npm run build && electron .",
    "build": "npm run prepare:runtime && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack": "npm run build && electron-builder --config electron-builder.lite.cjs --win portable --x64",
    "model:translation": "node scripts/download-translation.mjs",
    "model:reading": "node scripts/download-reading-models.mjs",
    "model:ocr": "node scripts/download-ocr.mjs",
    "pack:offline": "npm run build && electron-builder --win portable --x64",
    "format": "prettier --write src electron scripts tests *.ts *.cjs package.json .github",
    "format:check": "prettier --check src electron scripts tests *.ts *.cjs package.json .github",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:release": "npm run notices && npm run pack",
    "notices": "node scripts/prepare-notices.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@huggingface/transformers": "^3.7.5",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
    "perfect-freehand": "^1.2.2",
    "pinyin-ime": "1.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-keyboard": "3.8.119",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.12",
    "prettier": "3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.surfacetab.app",
    "productName": "TixTab",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release/0.2.37"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraFiles": [
      "README.md",
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*",
          "!previews/**/*",
          "!benchmarks/**/*",
          "!releases/*BUILD*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "native_texo.py",
          "openvino_app.py",
          "requirements-openvino.txt",
          "start-openvino.ps1",
          "native_opus.py",
          "opus_graph.py",
          "opus_tokenizer.py",
          "opus_store.py",
          "opus_cache.py",
          "native_ocr.py",
          "ocr_store.py",
          "requirements-ocr.txt",
          "native_piper.py",
          "piper_store.py",
          "managed_store.py",
          "cache_lease.py",
          "native_unimumer.py",
          "unimumer-manifest.json",
          "native_asr.py",
          "asr_worker.py",
          "asr-manifest.json",
          "requirements-asr.txt",
          "start-asr.ps1"
        ]
      },
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.zh-CN.md"
    ],
    "artifactName": "TixTab-${version}-${arch}.${ext}",
    "asarUnpack": [
      "electron/cache-helper.ps1",
      "electron/cache-catalog.json",
      "electron/dictation.ps1"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  },
  "license": "AGPL-3.0-only",
  "author": "TixTab contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pscgylotti/TixTab.git"
  },
  "homepage": "https://github.com/Pscgylotti/TixTab",
  "bugs": {
    "url": "https://github.com/Pscgylotti/TixTab/issues"
  },
  "overrides": {
    "sass": "1.101.0",
    "sharp": "0.35.5",
    "tinypool": "2.1.2",
    "nanoid@3.3.3": "3.3.20",
    "nanoid@4.0.2": "5.1.16",
    "lodash-es": "4.18.1"
  }
}
