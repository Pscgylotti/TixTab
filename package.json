{
  "name": "tixtab",
  "version": "0.3.10",
  "private": true,
  "description": "Pen-first PDF reading and annotation workspace",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:native-ocr": "node scripts/build-native-ocr.mjs",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "verify:icons": "node scripts/verify-icons.mjs --check",
    "model:texo": "node scripts/download-texo.mjs",
    "desktop": "electron .",
    "start": "npm run build && electron .",
    "build": "npm run check:models && npm run prepare:icons && npm run prepare:runtime && tsc --noEmit && vite build",
    "check:models": "node scripts/check-model-catalog.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark:workflow": "node scripts/benchmark-workflow.mjs",
    "benchmark:spatial": "node scripts/benchmark-spatial.mjs",
    "benchmark:compare": "node scripts/compare-workflows.mjs",
    "benchmark:build-control": "node scripts/build-performance-control.mjs",
    "test:performance-model": "node --test scripts/performance-demand.test.mjs",
    "pack": "npm run prepare:native-ocr && npm run prepare:windows-ai-ocr && npm run prepare:windows-ai-speech && npm run build && electron-builder --config electron-builder.lite.cjs --win nsis --x64",
    "pack:portable": "npm run prepare:native-ocr && npm run prepare:windows-ai-ocr && npm run prepare:windows-ai-speech && npm run build && electron-builder --config electron-builder.lite.cjs --win portable --x64",
    "model:translation": "node scripts/download-translation.mjs",
    "model:reading": "node scripts/download-reading-models.mjs",
    "model:ocr": "node scripts/download-ocr.mjs",
    "pack:offline": "npm run prepare:native-ocr && npm run prepare:windows-ai-ocr && npm run prepare:windows-ai-speech && npm run build && electron-builder --win nsis --x64",
    "format": "prettier --write src electron scripts tests *.ts *.cjs package.json .github",
    "format:check": "prettier --check src electron scripts tests *.ts *.cjs package.json .github",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:release": "npm run notices && npm run pack",
    "notices": "node scripts/prepare-notices.mjs",
    "prepare:windows-ai-ocr": "node scripts/build-windows-ai-ocr.mjs",
    "prepare:windows-ai-speech": "node scripts/build-windows-ai-ocr.mjs --speech"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@huggingface/transformers": "^3.7.5",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "katex": "^0.16.22",
    "koffi": "3.3.3",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.2",
    "pinyin-ime": "1.0.2",
    "rbush": "4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-keyboard": "3.8.119",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/rbush": "4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.12",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.surfacetab.app",
    "productName": "TixTab",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release/0.3.10"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/koffi/package.json",
      "node_modules/koffi/index.cjs",
      "node_modules/koffi/src/koffi/index.cjs",
      "node_modules/koffi/src/koffi/src/static.cjs",
      "node_modules/@koromix/koffi-win32-x64/**/*"
    ],
    "extraFiles": [
      {
        "from": ".cache/native-ocr/runtime",
        "to": "native/ocr"
      },
      {
        "from": ".cache/windows-ai-ocr/runtime",
        "to": "native/windows-ai-ocr"
      },
      {
        "from": ".cache/windows-ai-speech/runtime",
        "to": "native/windows-ai-speech"
      },
      "README.md",
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*",
          "!previews/**/*",
          "!benchmarks/**/*",
          "!performance/**/*",
          "!maintenance/**/*",
          "!PLAN.md",
          "!MILESTONE-0.3.0.md",
          "!RELEASE-0.3.0-READINESS.md",
          "!VALIDATION.md",
          "!PERFORMANCE.md",
          "!FRAMEWORK-PERFORMANCE.md",
          "!releases/*BUILD*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "native_texo.py",
          "openvino_app.py",
          "request_lifecycle.py",
          "requirements-openvino.txt",
          "start-openvino.ps1",
          "native_opus.py",
          "opus_graph.py",
          "opus_tokenizer.py",
          "opus_store.py",
          "opus_cache.py",
          "native_ocr.py",
          "native_tesseract.py",
          "experimental/tesseract_graph.py",
          "experimental/tesseract_batch_graph.py",
          "experimental/tesseract_pipeline.py",
          "ocr_store.py",
          "requirements-ocr.txt",
          "native_piper.py",
          "piper_store.py",
          "managed_store.py",
          "cache_lease.py",
          "native_unimumer.py",
          "native_hymt.py",
          "hymt-manifest.json",
          "hymt-openvino-manifest.json",
          "unimumer-manifest.json",
          "native_asr.py",
          "asr_worker.py",
          "asr_lifecycle.py",
          "asr-ort.config",
          "microphones.py",
          "asr-manifest.json",
          "requirements-asr.txt",
          "start-asr.ps1",
          "pdf_editor.py",
          "requirements-pdf.txt",
          "install_dependencies.py",
          "python-sources.json",
          "document_correct.py",
          "homr_runner.py",
          "homr_layout.py",
          "requirements-homr.txt",
          "requirements-copista.txt",
          "copista_runner.py",
          "copista_layout.py",
          "document_geometry.py",
          "matchmaker_runner.py",
          "requirements-matchmaker.txt",
          "wheels/*.whl",
          "wheels/*.json"
        ]
      },
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.zh-CN.md"
    ],
    "artifactName": "TixTab-${version}-setup-${arch}.${ext}",
    "asarUnpack": [
      "node_modules/@koromix/koffi-win32-x64/**/*.node",
      "electron/cache-helper.ps1",
      "electron/cache-catalog.json",
      "electron/dictation.ps1",
      "electron/microphone.cs",
      "electron/windows-ai-register.ps1",
      "electron/extract-audiveris.ps1"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/tixtab.ico",
      "signExecutable": false
    },
    "nsis": {
      "include": "electron/installer-upgrade.nsh",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TixTab",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/tixtab.ico",
      "uninstallerIcon": "public/tixtab.ico"
    },
    "portable": {
      "artifactName": "TixTab-${version}-portable-${arch}.${ext}",
      "unpackDirName": true
    }
  },
  "license": "AGPL-3.0-only",
  "author": "TixTab contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pscgylotti/TixTab.git"
  },
  "homepage": "https://github.com/Pscgylotti/TixTab",
  "bugs": {
    "url": "https://github.com/Pscgylotti/TixTab/issues"
  },
  "overrides": {
    "sass": "1.101.0",
    "sharp": "0.35.5",
    "tinypool": "2.1.2",
    "nanoid@3.3.3": "3.3.20",
    "nanoid@4.0.2": "5.1.16",
    "lodash-es": "4.18.1"
  }
}
